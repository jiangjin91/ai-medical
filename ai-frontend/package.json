{
  "name": "atguigu-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format:check": "prettier --check \"src/**/*.{js,vue}\" vite.config.js",
    "lint": "eslint src vite.config.js --max-warnings=0",
    "build": "npm run format:check && npm run lint && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lm-avatar-chat-sdk": "^1.1.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vite": "^6.2.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
